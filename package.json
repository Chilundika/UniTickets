{
  "name": "university-it-helpdesk",
  "version": "1.0.0",
  "description": "Simple, secure IT helpdesk ticketing for a university",
  "main": "server/app.js",
  "scripts": {
    "dev": "node --env-file-if-exists=.env --watch server/index.js",
    "start": "node --env-file-if-exists=.env server/index.js",
    "test": "node --test test/*.test.js",
    "db:setup": "node --env-file-if-exists=.env scripts/setup-db.js",
    "create-user": "node --env-file-if-exists=.env scripts/create-user.js",
    "reset-user": "node --env-file-if-exists=.env scripts/reset-user.js"
  },
  "license": "UNLICENSED",
  "dependencies": {
    "@vercel/functions": "^3.11.0",
    "aws4fetch": "^1.0.20",
    "express": "^5.3.0",
    "pg": "^8.23.1"
  },
  "private": true,
  "engines": {
    "node": "24.x"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.15"
  }
}
