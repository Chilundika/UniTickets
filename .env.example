# Copy to .env for local use (never commit .env). On Vercel, set these under
# Project > Settings > Environment Variables instead. See DEPLOY.md.

# Neon: use the POOLED connection string (host contains "-pooler").
# Leave empty for local development: an in-process database is used instead.
DATABASE_URL=

# Your live address, e.g. https://unitickets.vercel.app (no trailing slash)
BASE_URL=

# Long random secrets. Generate each with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
APP_SECRET=
CRON_SECRET=

# Resend (emails). MAIL_FROM must use a domain you verified in Resend.
RESEND_API_KEY=
MAIL_FROM=IT Helpdesk <helpdesk@yourdomain.com>

# Cloudflare Turnstile (CAPTCHA on the issue form)
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Cloudflare R2 (file uploads). Bucket must be PRIVATE (no public access).
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# Optional WhatsApp/SMS gateway that accepts POST {to, text}
WHATSAPP_WEBHOOK_URL=
WHATSAPP_TOKEN=
